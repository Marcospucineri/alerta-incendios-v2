# Puerto local. En Railway se inyecta automáticamente, no hace falta definirlo.
PORT=3000

# Activa el redirect forzado a HTTPS y el cacheo de estáticos.
NODE_ENV=development

# --- Mongo Atlas (opcional, hoy desactivado) ---
# Al definir MONGODB_URI y descomentar la rama en src/store.js, la app pasa a
# persistir los reportes en Atlas en lugar de memoria.
# MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=incendios
